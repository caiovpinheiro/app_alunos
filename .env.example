# Porta do servidor local
PORT=3000

# URL da API de certificados consumida pelo frontend.
# Padrão (vazio): usa a API local embutida em /api/certificates.
CERTIFICATE_API_URL=

# PostgreSQL (credenciais apenas no .env, nunca no código)
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false

# Postgres dos snapshots de matriculados (host diferente do DATABASE_* do app).
MATRICULADOS_HOST=
MATRICULADOS_PORT=5432
MATRICULADOS_DATABASE=disparos
MATRICULADOS_USER=
MATRICULADOS_PASSWORD=
MATRICULADOS_SSL=false

# Intervalo em minutos para criar acesso dos alunos novos do relatório.
ACESSOS_SYNC_INTERVAL_MIN=30

# Segredo para POST /api/admin/sync-acessos e /api/admin/sync-from-matriculados
IMPORT_SECRET=

# Aluno inicial criado somente se a tabela csu_alunos estiver vazia.
SEED_ALUNO_EMAIL=aluno@email.com
SEED_ALUNO_RGM=123456
SEED_ALUNO_PASSWORD=troque-esta-senha
SEED_ALUNO_NOME=Aluno de Teste

# Banco de matriculados (Postgres disparos — filtro de data e sync de acessos)
MATRICULADOS_HOST=
MATRICULADOS_PORT=5432
MATRICULADOS_DATABASE=
MATRICULADOS_USER=
MATRICULADOS_PASSWORD=
MATRICULADOS_SSL=false
ACESSOS_SYNC_INTERVAL_MIN=30

# WhatsApp padrão (fallback se o polo não tiver número próprio)
WHATSAPP_ACADEMICO_PADRAO=915184535
WHATSAPP_COMERCIAL_PADRAO=917479873

# Webhook opcional (n8n). Vazio = só salva no banco.
INDICACAO_WEBHOOK_URL=

# Admin separado do aluno (/admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador

# Imagens do plano de estudos (SVG/PNG). Volume persistente no EasyPanel.
PLAN_IMAGE_AUTO_SYNC=true
PLAN_IMAGE_SYNC_INTERVAL_MIN=60
PLAN_IMAGE_OUTPUT_DIR=/data/planos-estudos
# URL pública do portal (WhatsApp/e-mail). Ex.: https://aluno.seudominio.com
APP_PUBLIC_URL=

# Postgres com materias_alunos (eduit). No localhost, se DATABASE_NAME=eduit, não precisa repetir.
MATERIAS_HOST=
MATERIAS_PORT=5432
MATERIAS_DATABASE=eduit
MATERIAS_USER=
MATERIAS_PASSWORD=
MATERIAS_SSL=false
MATERIAS_TABLE=materias_alunos
# Opcional: filtrar por consultado_em (ISO). Ex.: 2026-09-01
MATERIAS_SINCE=
MATERIAS_PERIODO=2026/2

# Trilha EaD para Iniciantes em teste: RGM ou e-mail das contas que veem a trilha
# (separados por vírgula). * = todos os alunos. Vazio = ninguém.
TRILHA_LIBERADA_PARA=

# Chat do CRM (webchat) no portal, em teste: RGM ou e-mail das contas que veem o chat
# (separados por vírgula). * = todos os alunos. Vazio = ninguém.
WEBCHAT_LIBERADO_PARA=
# Script e chave do webchat (data-key do embed). Sem os dois, o chat não carrega.
WEBCHAT_EMBED_URL=
WEBCHAT_KEY=
# Chave de identidade do canal no CRM: assina o RGM (userHash) para o chat cair no contato e no negócio do aluno.
WEBCHAT_IDENTITY_SECRET=
# Pedido de ajuda: RGM ou e-mail das contas com a oferta "Quer falar com a equipe?". * = todos. Vazio = ninguém.
AJUDA_ATIVA_PARA=
# Entrada servidor a servidor do canal no CRM (.../api/public/webchat/s2s/{chave pública}) e a chave S2S do canal.
# O CRM devolve o link da conversa, que aparece no admin. Sem os dois, o pedido fica só no portal.
PEDIDO_AJUDA_WEBHOOK_URL=
PEDIDO_AJUDA_WEBHOOK_SECRET=

# Senha própria (server/senha.js): RGM ou e-mail das contas que, ao entrar com a senha inicial
# (primeiro nome + 123@), criam uma senha só delas antes de usar o portal. Depois disso a senha
# inicial não entra mais. "*" = todos (só quem vê as telas novas). Vazio = ninguém, nada muda.
TROCA_SENHA_PARA=

# Link de acesso (server/link-acesso.js): o n8n/CRM chama POST /api/integracoes/link-acesso com
# {rgm, origem} e este segredo (cabeçalho X-Segredo ou campo "segredo") e recebe um link que abre o
# portal já logado. Vale uma vez e expira em LINK_ACESSO_DIAS dias. Sem o segredo, fica desligado.
LINK_ACESSO_SEGREDO=
LINK_ACESSO_DIAS=7

# Grupo de estudo do curso, moderado por IA (docs/grupo-estudo.md). RGM ou e-mail; "*" = todos; vazio = ninguém
# (menu some e /api/grupos/* responde 404).
GRUPO_ESTUDO_ATIVA_PARA=
# Classificador das mensagens: stub (determinístico, sem rede) ou anthropic (precisa de ANTHROPIC_API_KEY e
# `npm i @anthropic-ai/sdk`). Regras baratas (telefone, link, gabarito...) rodam sempre, antes do classificador.
GRUPO_MODERACAO_PROVEDOR=stub
ANTHROPIC_API_KEY=
# Modelo do classificador (padrão claude-opus-5-5; claude-haiku-5-5 é mais barato para classificar).
GRUPO_MODERACAO_MODELO=
GRUPO_MODERACAO_TIMEOUT_MS=6000
# Se o classificador falhar: publicar (só mensagens sem nenhum sinal suspeito) ou reter (tudo vai para a fila).
GRUPO_MODERACAO_FALHA=publicar
# Fotos e áudios do grupo: dias até apagar (padrão 7) e pasta em disco. Em produção, a pasta precisa ser um
# volume persistente (ex.: /data/grupo-midia no EasyPanel); sem isso os arquivos somem a cada deploy.
GRUPO_MIDIA_DIAS=7
GRUPO_MIDIA_DIR=

# Área de simulado e estudo adaptativo (oculta, em validação local; desenho em docs/simulado.md).
# RGM ou e-mail das contas que veem a área; "*" = todos; vazio = desligada (menu some e /api/simulado/* dá 404).
SIMULADO_ATIVA_PARA=
# Só responde em localhost (padrão: true). Para liberar num servidor de verdade, true -> false.
SIMULADO_SO_LOCAL=true
# Provedor de IA: vazio = automático (anthropic se houver ANTHROPIC_API_KEY e o pacote @anthropic-ai/sdk;
# senão o stub determinístico, sem rede). stub | anthropic força um deles.
SIMULADO_LLM=
SIMULADO_LLM_MODELO=claude-opus-5-5
# Usa o mesmo ANTHROPIC_API_KEY do grupo de estudo, acima (só no Environment; nunca commitar).

# Aba Ao vivo do admin: segredo do webhook da régua. O passo webhook do CRM manda no campo "segredo" do corpo.
# Sem ele, o funil do portal funciona e o bloco da régua avisa "Falta ligar". Só no Environment; nunca no repositório.
REGUA_WEBHOOK_SEGREDO=

# Vigia da jornada do calouro (server/vigia.js, aba Vigia do admin). De 2 em 2 horas lê o app, o n8n e o CRM,
# guarda um retrato só com números e manda os alertas novos para a equipe no WhatsApp (via CRM).
# Tudo desligado sem estas variáveis. Chaves e tokens só no Environment do EasyPanel; nunca no repositório.
# true = roda sozinho de 2 em 2 horas (08h, 10h, 12h... de Brasília). Sem isso, só a leitura manual da aba.
VIGIA_LIGADO=
# Chave da API pública do n8n (Settings › n8n API). Sem ela, a fonte n8n fica "desligada".
N8N_API_KEY=
# Endereço do n8n (padrão: https://n8n-new-n8n.ca31ey.easypanel.host).
N8N_URL=
# Token de API do CRM (Bearer). Lê os templates aprovados e envia o alerta; sem ele, nada do CRM é lido nem enviado.
CRM_API_TOKEN=
# Endereço da API do CRM onde o token vale (padrão: https://integrations.bwipo.com, a API pública;
# o endereço do painel recusa tokens com "bearer_requires_public_api").
CRM_API_URL=
# Id da conversa da EQUIPE no CRM (grupo ou número interno) que recebe os alertas. Nunca a de um aluno.
# Vazio = os alertas ficam só na aba Vigia.
VIGIA_ALERTA_PARA=
# Nomes dos templates do WhatsApp que não podem sair de APPROVED nem virar MARKETING (separados por vírgula).
VIGIA_TEMPLATES_CHAVE=
# Endereço público checado pelo vigia (/health e o gerador de link). Padrão: APP_PUBLIC_URL.
VIGIA_APP_URL=
# Atalho para o aluno descobrir o e-mail acadêmico, checado a cada rodada (padrão:
# https://emailacademico.cruzeiroead.com.br/descobrir; deve redirecionar para o SSO da Cruzeiro do Sul).
VIGIA_EMAIL_ACADEMICO_URL=
# Automação BV lida pelo vigia e o passo do template de matrícula. Ao ligar a cópia "BV - Calouros (com checagem
# de acesso)", use VIGIA_CRM_BV=cmw5mcpv203h1ny01585i08vv e VIGIA_CRM_PASSO_MATRICULA=bvc-b9e9f48a-1656-43a9-b5b1-9196168cbec3.
VIGIA_CRM_BV=
VIGIA_CRM_PASSO_MATRICULA=
# Limites dos alertas em JSON (só o que mudar). Padrões: {"janela_min":120,"n8n_erros_min":1,"vendas_de":8,
# "vendas_ate":22,"link_vazio_pct":10,"link_min_amostra":3,"falhas_login_pct":30,"login_min_amostra":10,
# "bv_failed_min":1,"bv_ignorar_passos":[],"matricula_min":1,"email_failed_min":1,"regua_dias":14,"ab_min_amostra":60,
# "atraso_min":150,"lembrete_h":0}
VIGIA_LIMITES=

# Lembretes de acesso da régua (server/regua-fup.js, docs/regua-followups.md). A automação do CRM chama
# POST /api/integracoes/regua-fup com o segredo do link de acesso (LINK_ACESSO_SEGREDO). O app usa o
# CRM_API_TOKEN acima para marcar a tag app_entrou no negócio e gravar o link novo de cada lembrete.
# Ids dos campos do NEGÓCIO no CRM: o link completo e só o código (o que vai depois de /a/, para o botão do template).
CRM_CAMPO_LINK_ACESSO=
CRM_CAMPO_LINK_CODIGO=
# Nome da tag que o app marca no negócio quando a pessoa entra (padrão: app_entrou).
REGUA_TAG_ENTROU=
